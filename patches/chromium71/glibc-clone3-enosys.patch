                                pid_t current_pid,
                                int sysno) {
+#if defined(__x86_64__) && !defined(__ILP32__)
+  // glibc 2.34+ tries clone3 before falling back to clone on ENOSYS.
+  // Do not permit clone3: retain all existing restrictions on legacy clone.
+  constexpr int kClone3X86_64 = 435;
+  if (sysno == kClone3X86_64)
+    return Error(ENOSYS);
+#endif
